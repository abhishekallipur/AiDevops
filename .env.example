# Copy to .env and fill in only what you need. Never commit .env.
#
# The application runs with safe defaults even if you create no .env at all:
# the LLM layer falls back to a clearly-labelled MOCK plan and container tools
# are blocked when no Docker daemon is available.

# --- LLM provider (optional) -----------------------------------------------
# Leave OPENAI_API_KEY empty to use example plans. The AI assistant requires
# a configured key and reports an error when no provider is available.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# AIDEVOPS_LLM_TIMEOUT_SECONDS=30
# AIDEVOPS_LLM_MAX_RETRIES=1
# AIDEVOPS_LOCAL_ONLY=true
# External AI is restricted to these HTTPS hosts. Add another trusted host explicitly.
# AIDEVOPS_AI_ALLOWED_HOSTS=api.openai.com,openrouter.ai
#
# Any OpenAI-compatible gateway works, e.g. OpenRouter (hundreds of models):
#   OPENAI_API_KEY=sk-or-v1-...
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=openai/gpt-4o-mini          # or anthropic/claude-3.5-sonnet, etc.
# Models that reject response_format are handled: the provider retries without
# it and parses fenced/prose-wrapped JSON.

# --- Application ------------------------------------------------------------
AIDEVOPS_DATA_DIR=data
# AIDEVOPS_GENERATED_DIR=data/generated
# AIDEVOPS_DB_PATH=data/aidevops.db
AIDEVOPS_ALLOW_LOCAL_PATHS=true
# AIDEVOPS_CORS_ORIGINS=

# --- Analyzer limits --------------------------------------------------------
# AIDEVOPS_ANALYZER_MAX_FILES=2000
# AIDEVOPS_ANALYZER_MAX_FILE_BYTES=200000
# AIDEVOPS_ANALYZER_MAX_DEPTH=8
# AIDEVOPS_MAX_UPLOAD_BYTES=50000000
# AIDEVOPS_MAX_EXTRACT_FILES=5000

# --- Controlled execution ---------------------------------------------------
# auto     = run container tools when the Docker daemon is reachable, else block
# container= require containers; block if unavailable
# disabled = never run container tools (read-only lint still works)
AIDEVOPS_EXEC_BACKEND=auto
# AIDEVOPS_EXEC_TIMEOUT_SECONDS=120
# Image builds need longer than individual tests; configurable up to 1800 seconds.
# AIDEVOPS_BUILD_TIMEOUT_SECONDS=600
# AIDEVOPS_EXEC_MAX_OUTPUT_BYTES=100000
# AIDEVOPS_CONTAINER_IMAGE=python:3.12-slim

# --- UI ---------------------------------------------------------------------
# AIDEVOPS_API_URL=http://localhost:8000
# After successful login, open the Streamlit workspace at this URL.
# AIDEVOPS_DASHBOARD_URL=http://127.0.0.1:8501

# --- Local admin login ------------------------------------------------------
# The first backend startup creates this account in the application database.
# Local demo defaults: username=admin, password=admin123.
# Override these before starting the backend; never expose the demo password
# on a network or use it for a production deployment.
# AIDEVOPS_ADMIN_USERNAME=admin
# AIDEVOPS_ADMIN_PASSWORD=replace-with-a-long-unique-password
